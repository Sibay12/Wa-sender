# इस फ़ाइल को कॉपी करके नाम बदलें: .env  (फिर अपनी वैल्यू डालें)

# लॉगिन (Render पर ज़रूरी, लोकल पर चाहें तो खाली छोड़ें)
AUTH_USER=admin
AUTH_PASS=yahan-lamba-password-likhein

# सेशन कहाँ सेव होगा
# लोकल: ./session   |   Render (Disk के साथ): /data/session
SESSION_PATH=./session

# 10 अंक वाले नंबर के आगे यह कंट्री कोड जुड़ेगा
DEFAULT_COUNTRY_CODE=91

# मैसेज के बीच रैंडम गैप (सेकंड)
MIN_DELAY_SEC=20
MAX_DELAY_SEC=45

# पोर्ट (Render अपने आप सेट करता है, लोकल पर चाहें तो बदलें)
PORT=3000
