# Copy this file to ".env" and fill in your values.

# Login (required on Render; leave empty locally to disable login)
AUTH_USER=admin
AUTH_PASS=your-long-password-here
# Optional: secret used to sign login cookies (any long random text)
SESSION_SECRET=change-me-to-a-long-random-text

# Where the WhatsApp session is stored
# Local: ./session   |   Render (with Disk): /data/session
SESSION_PATH=./session

# Country code added to 10-digit numbers
DEFAULT_COUNTRY_CODE=91

# Random gap between messages (seconds)
MIN_DELAY_SEC=20
MAX_DELAY_SEC=45

# Keep-alive: the server pings its own /health every 10 minutes.
# Render sets RENDER_EXTERNAL_URL automatically. Elsewhere, set your public URL:
# PUBLIC_URL=https://your-app.example.com

PORT=3000
